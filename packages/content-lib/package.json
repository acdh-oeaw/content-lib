{
	"name": "@acdh-oeaw/content-lib",
	"version": "0.2.0",
	"license": "MIT",
	"repository": {
		"url": "https://github.com/acdh-oeaw/content-lib"
	},
	"type": "module",
	"engines": {
		"node": "^22 || ^24 || ^26"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^26",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12.21.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.21.0",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": "./dist/index.mjs"
	},
	"scripts": {
		"build": "tsdown",
		"format:check": "oxfmt --check . --ignore-path ../../.gitignore",
		"format:fix": "oxfmt --write . --ignore-path ../../.gitignore",
		"lint:check": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"prepublishOnly": "run-s build",
		"types:check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "catalog:",
		"@parcel/watcher": "catalog:",
		"change-case": "catalog:",
		"p-limit": "catalog:",
		"pluralize": "catalog:"
	},
	"devDependencies": {
		"@acdh-oeaw/tsconfig-lib": "catalog:",
		"@arethetypeswrong/core": "catalog:",
		"@types/node": "catalog:",
		"@types/pluralize": "catalog:",
		"npm-run-all2": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
