{
	"name": "@acdh-oeaw/content-lib",
	"version": "0.2.0",
	"license": "MIT",
	"repository": {
		"url": "https://github.com/acdh-oeaw/content-lib"
	},
	"type": "module",
	"engines": {
		"node": "^22 || ^24"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@10.24.0",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": "./dist/index.mjs"
	},
	"scripts": {
		"build": "tsdown",
		"format:check": "prettier . --cache --cache-location ./../../.prettiercache --check --ignore-path ./../../.gitignore  --ignore-path ./../../.prettierignore",
		"format:fix": "pnpm run format:check --write",
		"lint:check": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepublishOnly": "run-s build",
		"types:check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "catalog:",
		"@parcel/watcher": "catalog:",
		"change-case": "catalog:",
		"p-limit": "catalog:",
		"pluralize": "catalog:"
	},
	"devDependencies": {
		"@acdh-oeaw/eslint-config": "catalog:",
		"@acdh-oeaw/eslint-config-node": "catalog:",
		"@acdh-oeaw/prettier-config": "catalog:",
		"@acdh-oeaw/tsconfig-lib": "catalog:",
		"@arethetypeswrong/core": "catalog:",
		"@types/node": "catalog:",
		"@types/pluralize": "catalog:",
		"eslint": "catalog:",
		"eslint-config-flat-gitignore": "catalog:",
		"globals": "catalog:",
		"npm-run-all2": "catalog:",
		"prettier": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"lint-staged": {
		"*.@(js|ts)": [
			"eslint --fix",
			"prettier --cache --cache-location ./../../.prettiercache --write"
		],
		"*.!(js|ts)": "prettier --cache --cache-location ./../../.prettiercache --ignore-unknown --write"
	},
	"prettier": "@acdh-oeaw/prettier-config"
}
