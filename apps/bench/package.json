{
	"name": "@acdh-oeaw/content-lib-example-bench",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "^22 || ^24 || ^26"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^26",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12.21.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.21.0",
	"scripts": {
		"app:build": "next build",
		"app:dev": "next dev --turbopack",
		"build": "run-s content:build app:build",
		"dev": "concurrently --kill-others --names \"content,app\" --prefix-colors \"auto\" \"pnpm:content:dev\" \"pnpm:app:dev\"",
		"content:build": "NODE_DEBUG=content-lib dotenv -c -- tsx ./scripts/generate-content.ts build",
		"content:dev": "NODE_DEBUG=content-lib dotenv -c -- tsx ./scripts/generate-content.ts watch",
		"format:check": "oxfmt --check . --ignore-path ../../.gitignore",
		"format:fix": "oxfmt --write . --ignore-path ../../.gitignore",
		"lint:check": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"prepare": "run-s types:prepare",
		"start": "next start",
		"test:e2e": "PORT=3003 playwright test",
		"test:e2e:update-snapshots": "PORT=3003 playwright test --update-snapshots",
		"types:check": "tsc --noEmit",
		"types:prepare": "next typegen"
	},
	"dependencies": {
		"@acdh-oeaw/content-lib": "workspace:^",
		"@acdh-oeaw/lib": "catalog:",
		"next": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"valibot": "catalog:"
	},
	"devDependencies": {
		"@acdh-oeaw/tsconfig": "catalog:",
		"@mdx-js/mdx": "catalog:",
		"@playwright/test": "catalog:",
		"@tailwindcss/postcss": "catalog:",
		"@types/mdx": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"concurrently": "catalog:",
		"dotenv-cli": "catalog:",
		"is-in-ci": "catalog:",
		"npm-run-all2": "catalog:",
		"remark-gfm": "catalog:",
		"tailwindcss": "catalog:",
		"to-vfile": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vfile": "catalog:",
		"vfile-matter": "catalog:"
	},
	"postcss": {
		"plugins": {
			"@tailwindcss/postcss": {}
		}
	}
}
